                      {
                        "id": "tab-curl",
                        "tag": "div",
                        "style": {
                          "font_size": 15,
                          "padding": "16px",
                          "flex_direction": "column",
                          "align_items": "flex-start",
                          "justify_content": "flex-start"
                        },
                        "children": [
                          {
                            "id": "elem_pre_0x12c74789f5e0",
                            "tag": "div",
                            "style": {
                              "font_size": 15,
                              "flex_direction": "column",
                              "align_items": "flex-start",
                              "justify_content": "flex-start"
                            },
                            "children": [
                              {
                                "id": "elem_code_0x12c74789f650",
                                "tag": "div",
                                "text": "curl -X GET http://localhost:8089/api/v1/status curl -X POST http://localhost:8089/api/v1/consensus/diffuse curl -X POST http://localhost:8089/api/v1/rag/diffuse \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"seeds\": [0], \"steps\": 3, \"alpha\": 0.1}' curl -X POST http://localhost:8089/api/v1/records \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"id\": \"rec-1\", \"cell_id\": \"[0]\", \"dimension\": 0, \"vector\": [10.5, 4.2], \"payload\": {\"source\": \"rest_gateway\"}}' curl -X GET http://localhost:8089/api/v1/betti?tol=0.0001",
                                "style": {
                                  "font_size": 15,
                                  "flex_direction": "column",
                                  "align_items": "flex-start",
                                  "justify_content": "flex-start"
                                },
                                "children": [
                                  {
                                    "id": "elem_span_0x12c74789f6c0",
                                    "tag": "text",
                                    "text": "# 1. Запрос метрик и структуры клеточного комплекса",
                                    "style": {
                                      "color": "#6e7681",
                                      "font_size": 15,
                                      "flex_direction": "column",
                                      "align_items": "flex-start",
                                      "justify_content": "flex-start"
                                    }
                                  },
                                  {
                                    "id": "elem_span_0x12c74789f730",
                                    "tag": "text",
                                    "text": "# 2. Запуск теплового консенсуса Ходжа exp(-t * Delta_0)",
                                    "style": {
                                      "color": "#6e7681",
                                      "font_size": 15,
                                      "flex_direction": "column",
                                      "align_items": "flex-start",
                                      "justify_content": "flex-start"
                                    }
                                  },
                                  {
                                    "id": "elem_span_0x12c74789f7a0",
                                    "tag": "text",
                                    "text": "# 3. Симплициальное RAG-распространение контекста по гиперграфу",
                                    "style": {
                                      "color": "#6e7681",
                                      "font_size": 15,
                                      "flex_direction": "column",
                                      "align_items": "flex-start",
                                      "justify_content": "flex-start"
                                    }
                                  },
                                  {
                                    "id": "elem_span_0x12c74789f810",
                                    "tag": "text",
                                    "text": "# 4. Атомарный коммит векторного стебля в WAL журнал",
                                    "style": {
                                      "color": "#6e7681",
                                      "font_size": 15,
                                      "flex_direction": "column",
                                      "align_items": "flex-start",
                                      "justify_content": "flex-start"
                                    }
                                  },
                                  {
                                    "id": "elem_span_0x12c74789f880",
                                    "tag": "text",
                                    "text": "# 5. Вычисление топологических инвариантов и чисел Бетти комплекса",
                                    "style": {
                                      "color": "#6e7681",
                                      "font_size": 15,
                                      "flex_direction": "column",
                                      "align_items": "flex-start",
                                      "justify_content": "flex-start"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
